# Root-level example file.
# Copy the relevant values into the real .env files (they are git-ignored).

# ---- server/.env ------------------------------------------------------------
# MongoDB Atlas connection string (SRV). NEVER commit the real value.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
# Database used by the ELMS (kept separate from any existing database).
MONGO_DB_NAME=elms_db
# Port the Express API listens on.
PORT=5000
# Secret used to sign access tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Signing key for JWTs (optional, defaults to JWT_SECRET).
JWT_EXPIRES_IN=7d
# First administrator created by `npm run seed`.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@school.edu
SEED_ADMIN_PASSWORD=change-this-password

# ---- client/.env ------------------------------------------------------------
# Must be saved as UTF-8. Vite only exposes variables prefixed with VITE_.
# Local development: http://localhost:5000
# Production: the deployed API base URL (also set in the Vercel project settings).
VITE_API_URL=http://localhost:5000
